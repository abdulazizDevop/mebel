VITE_API_URL=http://localhost:8000

# Яндекс.Метрика. Leave empty to keep analytics fully off. When set, the
# counter script is injected ONLY after the visitor allows analytics cookies
# in the cookie banner (152-ФЗ / cookie consent).
VITE_METRIKA_ID=
# "1" turns on Webvisor session replay. Off by default: it records screens
# including chat messages — enable only after a deliberate decision.
VITE_METRIKA_WEBVISOR=
